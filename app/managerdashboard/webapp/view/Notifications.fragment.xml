<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <ResponsivePopover title="{i18n>notifications}" placement="Bottom" contentWidth="24rem">
        <List items="{dash>/notifications}" noDataText="{i18n>noNotifications}">
            <StandardListItem title="{dash>title}" description="{dash>desc}" icon="{dash>icon}"
                info="{dash>time}" infoState="{dash>state}" wrapping="true"/>
        </List>
    </ResponsivePopover>
</core:FragmentDefinition>
